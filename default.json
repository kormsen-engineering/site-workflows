{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Astro sites edited with the Kormsen CMS: weekly, grouped, exact pins; the Kormsen CMS and Astro move together; nothing merges by itself.",
	"extends": [
		"config:recommended",
		":dependencyDashboard",
		"schedule:weekly",
		":timezone(Europe/London)",
		"helpers:pinGitHubActionDigests"
	],
	"rangeStrategy": "pin",
	"automerge": false,
	"platformAutomerge": false,
	"ignoreTests": false,
	"packageRules": [
		{
			"description": "Group: one weekly PR for every non-major update.",
			"matchUpdateTypes": [
				"minor",
				"patch",
				"pin",
				"digest",
				"pinDigest"
			],
			"groupName": "non-major dependencies",
			"groupSlug": "non-major"
		},
		{
			"description": "Majors wait for approval on the Dependency Dashboard.",
			"matchUpdateTypes": [
				"major"
			],
			"dependencyDashboardApproval": true
		},
		{
			"description": "The Kormsen CMS edit build patches one Astro file, so @kormsen-engineering/cms-astro and astro always move together, pinned exactly.",
			"matchPackageNames": [
				"@kormsen-engineering/cms-astro",
				"astro"
			],
			"groupName": "Kormsen CMS and Astro",
			"groupSlug": "kormsen-cms-astro",
			"rangeStrategy": "pin"
		},
		{
			"description": "Astro never merges by itself.",
			"matchPackageNames": [
				"astro"
			],
			"automerge": false
		}
	]
}
